# DB (로컬 또는 AWS RDS URL, 비밀번호에 # 등 있으면 %23 등으로 인코딩)
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public&sslmode=require"

# NextAuth (Vercel 배포 시 NEXTAUTH_URL은 https://도메인 주소로 설정)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="랜덤한-긴-문자열-생성"

# Google Gemini (채팅 AI)
GEMINI_API_KEY=""

# AWS (나중에 S3 음성 파일 등)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-northeast-2
# S3_BUCKET_VOICE=

# 공개 플래그(NEXT_PUBLIC_ — 빌드 타임에 번들에 박힌다. 바꾸면 재배포)
# NEXT_PUBLIC_APP_ON_PLAY=1   # 1.2.0 프로덕션 단계적 출시가 100%가 된 뒤 켜기("공개"만으로는 아님 — 로그인 다운로드 버튼→Play, 기기 등록 경고 활성)

# ── 웹 결제(포트원 V2 정기결제 — 카드·카카오페이·네이버페이, 2026-10-22) ──
# 설정 순서·확인 방법: docs/billing/웹결제_설정_가이드.md
# 웹 브라우저 전용이다 — 앱 WebView에는 PG 화면·문구·링크가 나오지 않고 서버도 앱 요청을 거절한다(가입은 WebView 표지로 넓게,
#   해지·환불은 우리 앱이 틀림없을 때만 — 다른 앱의 인앱 브라우저를 오판해 해지를 막지 않게).
# 전부 서버 런타임 값이다. NEXT_PUBLIC_를 붙이지 않는다(번들에 박혀 재빌드 없이 못 바꾼다 — 화면에는 서버가 config API로 내려준다).
# Vercel에 넣거나 바꾼 뒤에는 재배포해야 반영된다. [비밀]은 Vercel에서 종류를 Secret으로 넣고, 코드·채팅·문서에 붙여 넣지 않는다.
# 아래 예시는 형식만 보여 준다(실제 값 아님).
#
# 기능 스위치 — 정확히 1일 때만 켜진다("true"·" 1"은 꺼짐). 꺼져 있으면 새 가입(요금 안내·결제 화면·결제 시작)이 전부 꺼진다(기본: 꺼짐).
#   이미 만든 이용권의 해지·환불·결제 결과 처리·예약 작업·약관 화면은 상점 아이디(PORTONE_STORE_ID)가 있으면 계속 돈다
#   (끄고 나서도 포트원이 예약 결제를 실행하므로 — lib/billing/portone-route.ts 머리말). API Secret이 빠지거나 만료돼도 해지 화면은 열리고
#   예약 작업이 운영 경보를 보낸다. 상점 아이디를 넣기 전에는 전부 꺼져 운영 변화가 없다.
#   ⚠ 결제를 그만 팔 때는 이 스위치만 끈다 — 상점 아이디·API Secret은 마지막 이용권이 끝나고 환불이 다 끝날 때까지 지우지 않는다.
#   켜지려면 아래가 **모두** 있어야 한다. 하나라도 없으면 1이어도 꺼진 채로 있다(빠진 이름은 config API 503 로그에). 비밀 아님.
#     PORTONE_STORE_ID·PORTONE_API_SECRET·PORTONE_WEBHOOK_SECRET·채널 키 1개 이상·팔 수 있는 요금제·PORTONE_MODE(test|live 명시)·
#     CRON_SECRET·SERVICE_GMAIL_USER·SERVICE_GMAIL_APP_PASSWORD(위급 메일 계정과 다른 계정)·BIZ_* 8개(BIZ_HOSTING 제외)·
#     기존 변수 ENCRYPTION_KEY(빌링키 암호화 저장)
# BILLING_PG_ENABLED=1
#
# 상점 아이디 — 포트원 콘솔 [결제 연동] > [연동 관리] > [연동 정보] 오른쪽 위. 비밀 아님(서버가 결제창용으로 브라우저에 내려준다).
# PORTONE_STORE_ID=store-00000000-0000-0000-0000-000000000000
#
# 결제수단별 채널 키 — [연동 관리] > [채널 관리]. 비밀 아님. 비어 있는 결제수단은 버튼을 숨긴다.
#   시험할 때는 테스트 채널 키, 실연동 전환 때 실연동 채널 키로 바꾼다. 네이버페이는 네이버페이 승인 뒤에 넣는다(그 전엔 비워 둔다).
# PORTONE_CHANNEL_KEY_CARD=channel-key-00000000-0000-0000-0000-000000000000
# PORTONE_CHANNEL_KEY_KAKAOPAY=channel-key-00000000-0000-0000-0000-000000000000
# PORTONE_CHANNEL_KEY_NAVERPAY=
#
# [비밀] V2 API Secret — [연동 관리] > [식별코드·API Keys] > [V2 API] > 새로운 API Secret 발급. 발급 직후 한 번만 보인다.
#   발급 때 정한 만료일이 지나면 자동결제가 전부 실패한다 — 만료 전에 새로 발급해 바꾸고 이전 값은 지운다.
# PORTONE_API_SECRET=
#
# [비밀] 웹훅 시크릿 — [연동 관리] > [결제알림(Webhook) 관리] > 웹훅 시크릿 발급. 테스트·실연동 값이 다르다(실연동 전환 때 바꾼다).
#   웹훅 주소: https://maeum-ieu.vercel.app/api/billing/portone/webhook (결제받을 도메인이 바뀌면 같이 바꾼다)
# PORTONE_WEBHOOK_SECRET=
#
# test 또는 live — 결제·빌링키의 채널 종류(TEST/LIVE)를 이 값과 대조한다. 비밀 아님.
#   둘 중 하나를 **정확히** 넣어야 판매가 켜진다(비우면 대조는 test로 하지만 판매는 꺼진 채 — 운영에서 빠지면 실결제가 대조에 걸린다).
#   live는 채널 키를 실연동 채널로 바꾼 뒤에만. live에서는 테스트 채널 결제로 혜택을 주지 않는다(그 반대도 같다).
#   live로 바꾼 뒤 남은 시험 결제가 실행되면 혜택 없이 전액 취소하고 그 이용권을 끝낸다(운영 경보).
# PORTONE_MODE=test
#
# 시험(test) 모드에서 결제를 시작할 수 있는 계정 — 사용자 id를 쉼표로(운영자·PG 심사용 계정). 비밀 아님. live에서는 보지 않는다.
#   비우면 아무도 시험 결제를 할 수 없다(시험 채널 결제는 돈이 나가지 않거나 밤에 취소되는데 서버는 유료 혜택을 준다 — 아무나 열면 안 된다).
#   "*"는 모두 허용 — 개발 환경에서만. 운영에 넣지 않는다.
# PORTONE_TEST_USER_IDS=
#
# 유료 요금제(JSON 배열, 한 줄) — 비우면 임시 기본 3개(하루 20회 월 14,900원 · 30회 19,900원 · 60회 39,900원). 비밀 아님.
#   하나라도 형식이 틀리면 유료 요금제를 아예 노출하지 않는다(경고 로그만). id는 영소문자·숫자 1~20자, priceKrw는 부가세 포함 월 금액(100~1,000,000원).
#   dailyTurnLimit은 무료 한도(기존 변수 DAILY_TURN_LIMIT — 미설정이면 코드 기본 100)보다 커야 한다. 아니면 유료가 하나도 안 보인다.
#   표시 이름은 '월 이용권(하루 대화 N회)'로 자동으로 만든다(name은 읽지 않는다).
#   이미 가입한 구독은 가입 당시 금액·한도를 그대로 쓴다 — 여기를 바꾸면 새 가입자에게만 적용된다.
#   아래 줄의 바깥 작은따옴표는 .env 파일용이다. Vercel 화면에는 [ 부터 ] 까지만 넣는다.
# BILLING_PLANS='[{"id":"day20","dailyTurnLimit":20,"priceKrw":14900},{"id":"day30","dailyTurnLimit":30,"priceKrw":19900},{"id":"day60","dailyTurnLimit":60,"priceKrw":39900}]'
#
# [비밀] 예약 작업(/api/cron/billing — 하루 1회: 결제 결과 대사·만료 처리·결제 3일 전 안내 메일·못 보낸 결제 완료 메일·덜 된 환불) 인증값.
#   Vercel Cron(AWS로 옮기면 EventBridge — docs/billing/웹결제_설정_가이드.md 4단계)이 Authorization: Bearer <이 값>을 붙여 부른다.
#   16자 이상 무작위(예: Git Bash에서 openssl rand -hex 32). 없으면 판매가 켜지지 않는다.
# CRON_SECRET=
#
# 결제 안내 메일 계정(Gmail) — 결제 완료·3일 전·실패·해지·환불 메일과 결제 운영 경보를 보낸다. 없으면 판매가 켜지지 않는다.
#   ⚠ 위급 알림 메일 계정(GMAIL_USER)과 **다른 계정**이어야 한다 — 같은 계정이면 결제 메일이 Gmail 하루 발신 한도를 써 보호자 위급 메일이
#   막힐 수 있다(같으면 판매가 켜지지 않는다). 앱 비밀번호는 그 계정의 Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호.
# SERVICE_GMAIL_USER=
# [비밀]
# SERVICE_GMAIL_APP_PASSWORD=
#
# 사업자 정보 — /login·/pricing·/subscribe·/terms/*·/privacy 하단과 결제 안내 메일에 나간다. 사업자등록증·공정위 조회 정보와 글자까지 같게.
#   비어 있는 항목은 화면에서 숨기고 서버 로그에 [biz-info] 경고를 남긴다(BIZ_HOSTING만 비우면 Vercel Inc.). 비밀 아님(공개 표시).
#   BIZ_HOSTING을 뺀 8개가 모두 있어야 판매가 켜진다(결제 직전 고지·결제 완료 메일의 판매자 정보).
#   BIZ_NAME 상호 · BIZ_OWNER 대표자 · BIZ_ADDRESS 사업장 주소(불만 처리 주소 포함) · BIZ_PHONE 유선 대표번호(휴대폰 번호 불가 — 카카오페이는 유선만)
#   BIZ_EMAIL 고객센터 이메일 · BIZ_REG_NO 사업자등록번호(000-00-00000 꼴 — 숫자 10자리여야 공정위 사업자정보 확인 링크가 붙는다)
#   BIZ_MAIL_ORDER_NO 통신판매업 신고번호 · BIZ_MAIL_ORDER_AUTHORITY 통신판매업 신고기관
#   BIZ_HOSTING 호스팅 제공자 상호(지금 Vercel Inc. — AWS로 옮기면 바꾼다)
# BIZ_NAME=
# BIZ_OWNER=
# BIZ_ADDRESS=
# BIZ_PHONE=
# BIZ_EMAIL=
# BIZ_REG_NO=
# BIZ_MAIL_ORDER_NO=
# BIZ_MAIL_ORDER_AUTHORITY=
# BIZ_HOSTING=Vercel Inc.
#
# 앱 안 Play 구독 구매 버튼 — 1일 때만 보인다. 기본은 꺼짐(앱 구독 화면은 구독 상태만 보여 준다). 비밀 아님.
#   기본을 끄는 이유: 네이버페이 결제형 가이드의 "구글 인앱 결제 연동 시 결제형 입점 불가" 문구와 Play 수수료.
#   ⚠ 이 코드를 배포하면 지금 앱에 보이던 Play 구매 버튼이 사라진다(이 값이 1이 아니면) — 배포 전에 1로 둘지 정한다.
# BILLING_PLAY_ENABLED=1
#
# ※ 함께 보는 기존 변수(이 묶음에 없는 것): DAILY_TURN_LIMIT(무료 한도 — 위 요금제 한도보다 작아야 유료가 보인다. 바꿀지는 사용자 결정.
#   가입한 이용권은 가입 당시 무료 한도로 '유료 혜택 사용'을 판정한다), ENCRYPTION_KEY(없으면 PG가 켜지지 않는다),
#   GMAIL_USER·GMAIL_APP_PASSWORD(위급 알림 메일 전용 — 결제 메일은 위 SERVICE_GMAIL_*로만 보낸다),
#   NEXTAUTH_URL(결제창이 돌아오는 주소와 메일 속 구독 관리·약관 링크의 기준),
#   OPS_ALERT_EMAIL(운영 경보를 받는 곳 — 결제 경보는 결제 안내 메일 계정으로 보내고, 비우면 그 계정 자신에게).
