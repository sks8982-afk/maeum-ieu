// 마음이음 - PostgreSQL (AWS RDS + pgvector)
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// NextAuth
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  age           Int?
  gender        String?
  guardianName  String?   // 보호자 이름
  guardianPhone String?   // 보호자 연락처
  guardianRelation String? // 보호자 관계 (아들, 딸, 배우자 등)
  guardianEmail String?   // 보호자 이메일 (응급 알림용)
  guardianWebhookUrl String? // 보호자 Webhook URL (Discord/Slack/IFTTT/n8n 등)
  companionName     String?  @default("민지") // AI 동반자 이름
  companionRelation String?  @default("손녀") // AI 동반자 관계 (손녀/손자/딸/아들/며느리/친구 등)
  userHonorific     String?                   // 사용자 호칭 override (null이면 성별 자동 추론)
  screeningMode     String   @default("user")  // 계정 역할: user=어르신(대화만) / pro=의사(상세 열람) / guardian=보호자(요약·알림만) / general=일반인(자가점검)
  expertCode        String?  @unique           // 전문가 초대 코드 (pro 계정이 환자 연결용으로 발급)
  consentedAt       DateTime?                   // 건강정보 수집·이용 동의 시각 (null=미동의)
  consentVersion    String?                     // 동의한 약관 버전
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  conversations Conversation[]
  medicationSchedules MedicationSchedule[]
  expertLinks   ExpertPatient[] @relation("ExpertLinks")
  patientLinks  ExpertPatient[] @relation("PatientLinks")
  subscriptionsPaid     Subscription[] @relation("SubscriptionsPaid")
  subscriptionsReceived Subscription[] @relation("SubscriptionsReceived")
}

/// 전문가(의사·간호사·보호사) ↔ 환자 연결. 환자 본인이 마이페이지에서 전문가 코드를 입력해 연결(=본인 동의).
/// 전문가는 연결된 환자의 채점·요약만 열람(대화 원문 비공개 — 프라이버시 기본값).
/// ⚠️ 신규 테이블 생성은 prisma db push 금지(raw 테이블 drop 사고 이력) — 수동 SQL(scripts/ops-create-expert-tables.ts) + prisma generate.
model ExpertPatient {
  id            String   @id @default(cuid())
  expertUserId  String
  patientUserId String
  status        String   @default("active") // active | revoked
  createdAt     DateTime @default(now())

  expert  User @relation("ExpertLinks", fields: [expertUserId], references: [id], onDelete: Cascade)
  patient User @relation("PatientLinks", fields: [patientUserId], references: [id], onDelete: Cascade)

  @@unique([expertUserId, patientUserId])
  @@index([expertUserId])
  @@index([patientUserId])
}

/// 일과/복약 알림 스케줄. 한 사용자에 여러 약 등록 가능.
/// times: ["09:00", "13:00", "20:00"] (KST 24시간 표기)
/// lastTriggeredAt: 마지막 알림 발송 시각 (같은 슬롯 중복 발송 차단용)
model MedicationSchedule {
  id              String   @id @default(cuid())
  userId          String
  label           String   // "혈압약", "당뇨약", "아침 영양제" 등
  times           Json     // string[] — 하루 중 복용 시각 배열
  enabled         Boolean  @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, enabled])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String   @unique
  title     String?  @default("새 대화")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id                String   @id @default(cuid())
  conversationId    String
  role              String
  content           String
  isAnomaly         Boolean? @default(false)
  analysisNote      String?
  emergencyLevel    Int?     // 0=정상, 1=관찰, 2=주의, 3=즉시. null=미평가/AI 발화
  emergencyEvidence String?  // 매칭된 키워드/구문 (디버깅·보호자 알림용)
  notifiedAt        DateTime? // 보호자 알림 발송 시각 (null=미발송)
  speakerLabel      String?  // "primary" | "visitor" | "unknown" — null=미라벨
  createdAt         DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// 대화 이력 조회는 매 턴 (conversationId, createdAt DESC)로 돈다. PostgreSQL은 관계만으로
  /// 인덱스를 만들지 않아 실측상 Seq Scan이었다(13,934행 전수 스캔, 2026-09-30 EXPLAIN 확인).
  /// ⚠️ 적용은 `prisma db push` 금지(raw SQL 테이블 drop 사고 이력) — scripts/ops-create-message-index.ts 사용.
  @@index([conversationId, createdAt])
}

/// 구독(Google Play Billing) — 결제자와 혜택 대상을 분리한다.
///
/// 왜 분리하나: 70~90대 어르신이 Play 결제를 직접 하기는 어렵다. 보호자가 자기 Play 계정으로
///   결제하고, 혜택은 **연결된 어르신 계정**에 적용되어야 한다(ExpertPatient active 링크 기준).
///   purchaserUserId = 결제한 사람, beneficiaryUserId = 상한이 올라가는 사람(같을 수도 있다).
///
/// 신뢰 원천은 Google이다. purchaseToken을 Play Developer API로 검증한 결과만 기록하고,
///   클라이언트가 보낸 상태는 절대 신뢰하지 않는다. 갱신·취소·환불은 RTDN(Pub/Sub)으로 반영한다.
///
/// ⚠️ 신규 테이블 생성은 prisma db push 금지(raw 테이블 drop 사고 이력)
///    — scripts/ops-create-subscription.ts + prisma generate.
///
/// 웹 PG 정기결제(포트원, 2026-10-22): 같은 표에 provider='portone' 행으로 둔다(혜택 판정 한 곳 — lib/billing/entitlement).
///   포트원 행은 purchaseToken = "portone:{issueId}", productId = 요금제 id(lib/billing/portone-plans).
///   추가 컬럼은 모두 nullable·기본값이라 기존 Play 행에는 영향이 없다 — scripts/ops-billing-pg.ts(추가만) + prisma generate.
///   결제 원장·동의 기록은 이 표가 아니라 BillingPayment·BillingConsent에 둔다(이 표는 User 삭제에 Cascade라 5년 보존을 못 한다).
model Subscription {
  id                 String    @id @default(cuid())
  purchaserUserId    String
  beneficiaryUserId  String
  productId          String // Play 구독 상품 ID · 포트원은 요금제 id
  purchaseToken      String    @unique // Play 구매 토큰 — 검증·RTDN 조회 키 · 포트원은 "portone:" + issueId
  /// active | grace | on_hold | paused | canceled | expired | revoked
  /// canceled = 해지 예약(만료일까지는 혜택 유지), expired/revoked = 혜택 종료
  /// 포트원 행은 pending(빌링키 발급 대기) → activating(첫 결제 중) → active, 첫 결제 실패는 failed — 셋 다 혜택 없음
  status             String    @default("active")
  /// 혜택 만료 시각(Play expiryTime). 이 시각 전까지만 유료 티어.
  /// 포트원은 이번 이용기간 끝(= 다음 결제 시각), 결제 실패 재시도 중(grace)에는 재시도 시각 + 하루
  expiresAt          DateTime?
  /// 마지막으로 Google에 검증한 시각 — 오래된 상태를 신뢰하지 않기 위한 기준
  verifiedAt         DateTime  @default(now())
  /// 환불·강제 해지 시각(null=유효)
  revokedAt          DateTime?
  /// 결제 경로 — play(기존 행 기본값) | portone(웹 PG 정기결제). 아래 컬럼은 portone 행에서만 쓴다
  provider           String    @default("play")
  payMethod          String? // CARD | KAKAOPAY | NAVERPAY
  /// 가입 당시 월 금액(부가세 포함) — 갱신 결제는 이 금액으로만(요금 인상은 30일 전 별도 동의 — 전자상거래법 제13조⑥)
  priceKrw           Int?
  /// 가입 당시 요금제의 하루 대화 상한 — 요금제 설정이 바뀌거나 깨져도 이미 낸 돈만큼의 혜택은 그대로
  dailyTurnLimit     Int?
  /// 빌링키 AES 암호문(lib/crypto encryptPII) — 해지·만료 때 포트원에서 지운 뒤 null
  billingKeyEnc      String?
  anchorDay          Int? // 매월 결제 기준일(KST 1~31, 그날이 없는 달은 말일)
  cycleNo            Int       @default(0) // 결제가 끝난 회차 수
  nextChargeAt       DateTime? // 다음 결제(갱신·재시도) 예정 시각 — 더 결제하지 않으면 null
  /// 포트원 결제 예약 id — "이미 예약돼 있다"는 응답만 받았으면 그 예약의 결제 id(예약 취소는 빌링키 단위라 id는 '예약 있음' 표시로만 쓴다)
  nextScheduleId     String?
  cancelAtPeriodEnd  Boolean   @default(false)
  failedChargeCount  Int       @default(0)
  canceledAt         DateTime?
  /// normal | immediate | withdrawal | payment_failed | link_gone | key_deleted | refunded | purchaser_deleted | beneficiary_deleted
  ///   | revoked_external(포트원에서 예약이 취소됨) | test_mode_ended(시험 결제 정리)
  ///   · 결제 시작을 막은 시도(failed)는 expired | duplicate | config | not_linked
  cancelType         String?
  renewalNoticeFor   DateTime? // 결제 3일 전 안내를 보낸 결제 예정 시각(같은 회차에 두 번 보내지 않게)
  /// 가입 당시 무료 하루 대화 한도(DAILY_TURN_LIMIT) — '유료 혜택 사용' 판정이 나중에 바뀐 무료 한도로 거꾸로 달라지지 않게(lib/billing/portone-cancel)
  freeTurnLimit      Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  purchaser   User @relation("SubscriptionsPaid", fields: [purchaserUserId], references: [id], onDelete: Cascade)
  beneficiary User @relation("SubscriptionsReceived", fields: [beneficiaryUserId], references: [id], onDelete: Cascade)

  /// 혜택 판정은 매 턴 (beneficiaryUserId, status, expiresAt)로 돈다
  @@index([beneficiaryUserId, status])
  @@index([purchaserUserId])
  /// 예약 작업(대사·만료·3일 전 안내)이 포트원 행을 결제 예정 시각으로 찾는다
  @@index([provider, status, nextChargeAt])
}

/// 포트원 결제 원장 — 회차마다 본 결제·재시도·환불을 한 행씩(paymentId는 회차별로 정해진 값 — lib/billing/portone-period paymentIdFor).
///
/// ⚠ FK가 없다(id 문자열만): User·Subscription을 지워도 연쇄 삭제되지 않게 — 대금결제·계약·청약철회 기록 5년 보존
///   (전자상거래법 시행령 제6조). 빌링키 원문은 두지 않고 지문(sha256 앞 32자)만 둔다.
/// ⚠️ prisma db push 금지 — scripts/ops-billing-pg.ts + prisma generate.
model BillingPayment {
  paymentId       String    @id
  subscriptionId  String
  purchaserUserId String
  cycleNo         Int
  kind            String // first | renewal | retry
  attempt         Int       @default(0) // 0 = 본 결제, 1·2 = 재시도
  amountKrw       Int
  payMethod       String?
  billingKeyHash  String // 결제에 쓴 빌링키의 지문 — 포트원 조회 결과와 대조한다
  /// requested | scheduled | paid | failed | cancelled | partial_cancelled | revoked(예약 취소)
  status          String
  periodStart     DateTime? // 이 회차 이용기간 시작(갱신은 예정 시각, 첫 결제는 결제 시각)
  periodEnd       DateTime? // 이 회차 이용기간 끝(= 다음 결제 시각) — 결제 완료 때 채운다
  scheduledAt     DateTime? // 예약 결제 시각(즉시 결제는 null)
  paidAt          DateTime?
  cancelledKrw    Int       @default(0)
  /// 지금 해지·청약철회 뒤 이 결제의 누적 취소액이 되어야 할 값 — 신청 시점에 고정(다시 시도해도 같은 목표 → 이중 환불 없음)
  refundTargetKrw Int?
  failureReason   String?
  receiptUrl      String?
  /// 결제 완료 안내 메일을 보낸 시각 — 못 보냈으면 null(예약 작업이 다시 보낸다 — 자동결제마다 알려야 한다, 전자상거래법 제8조③)
  paidMailAt      DateTime?
  /// 이 결제의 계약을 끝낸 해지·청약철회 — 종류(normal·immediate·withdrawal·link_gone…)와 신청 시각. 구독 기록은 계정과 함께 지워져도
  ///   이 원장은 남는다(계약·청약철회 기록 5년 — 시행령 제6조). unwanted = 해지 뒤 실행돼 전액 취소한 결제(그 시각에 취소를 요청)
  cancelType      String?
  cancelRequestedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([subscriptionId, cycleNo])
  @@index([purchaserUserId, createdAt])
}

/// 결제 동의 기록 — 항목·문구 버전·시각(분쟁 대비). FK 없음(계약 기록 5년 보존 — 시행령 제6조).
model BillingConsent {
  id             String   @id @default(cuid())
  userId         String
  subscriptionId String?
  termsVersion   String
  items          Json // 동의 항목 이름 배열
  /// 동의할 때 화면에 안내한 조건 — 요금제 id·월 금액·하루 대화 한도·무료 한도·결제수단·혜택 받는 분(계약 내용 기록 — 구독 기록이 지워져도 남는다)
  offer          Json?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([subscriptionId])
}

/// 처리한 포트원 웹훅 — webhook-id(재전송해도 같은 값)로 중복 처리를 막는다.
model BillingWebhookEvent {
  webhookId  String   @id
  type       String
  receivedAt DateTime @default(now())
}

// 참고: cognitive_assessments 테이블은 Prisma 외부 (raw SQL)로 관리
// 참고: message_embeddings 테이블은 Prisma 외부 (raw SQL)로 관리
